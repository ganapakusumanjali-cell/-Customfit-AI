rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection - PII isolation
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId)
        && incoming().name is string && incoming().name.size() <= 100
        && incoming().email is string && incoming().email.size() <= 120;
      allow update: if isOwner(userId)
        && incoming().email == existing().email
        && incoming().name is string && incoming().name.size() <= 100;
      allow delete: if false;
    }

    // Designs collection
    match /designs/{designId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && incoming().userId == request.auth.uid
        && incoming().garmentType is string && incoming().garmentType.size() <= 50
        && incoming().size is string && incoming().size.size() <= 20
        && incoming().color is string && incoming().color.size() <= 50
        && incoming().fabric is string && incoming().fabric.size() <= 50
        && incoming().estimatedPrice is number;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && incoming().userId == resource.data.userId;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Orders collection
    match /orders/{orderId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && incoming().userId == request.auth.uid
        && incoming().designId is string && incoming().designId.size() <= 128
        && incoming().price is number;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && incoming().userId == resource.data.userId;
      allow delete: if false;
    }

    // Measurements collection
    match /measurements/{measurementId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && incoming().userId == request.auth.uid
        && incoming().title is string && incoming().title.size() <= 80;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && incoming().userId == resource.data.userId;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
